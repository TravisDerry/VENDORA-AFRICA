{
  "expo": {
    "name": "Vendora Africa",
    "slug": "vendora-africa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#1B4F72",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4F72"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vendoraafrica.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vendoraafrica.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4F72"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vendora Africa uses your photos so you can add pictures of your business and products.",
          "cameraPermission": "Vendora Africa uses the camera so you can take pictures of your business and products."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "611a8ab3-6b41-436b-8402-ef2cc878bd3c"
      }
    },
    "owner": "derrytravis"
  }
}
